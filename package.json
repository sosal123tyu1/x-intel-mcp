{
  "name": "x-intel-mcp",
  "version": "0.2.1",
  "description": "High-performance zero-auth Twitter/X intelligence, crypto cashtag analyzer, and sentiment scoring MCP server for Claude Code, Cursor, Pi, and LLMs.",
  "main": "dist/server.js",
  "bin": {
    "x-intel-mcp": "./dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "bun build src/server.ts --outdir dist --target node && bun build src/cli.ts --outdir dist --target node && chmod +x dist/cli.js",
    "start": "node dist/server.js",
    "dev": "bun run src/server.ts",
    "test": "bun test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "twitter",
    "x",
    "claude-code",
    "cursor",
    "ai-agents",
    "crypto-sentiment",
    "sentiment-analysis"
  ],
  "author": "sosal123tyu1 (Ali Cent)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sosal123tyu1/x-intel-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/sosal123tyu1/x-intel-mcp/issues"
  },
  "homepage": "https://github.com/sosal123tyu1/x-intel-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1"
  }
}
